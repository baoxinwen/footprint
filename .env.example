# JWT 密钥（必填，用于签发认证 token）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# 前后端使用同一个不可变发布标签，例如 GitHub Actions 生成的 sha-1a2b3c4
FOOTPRINT_IMAGE_TAG=sha-replace-with-published-version

# 持久化数据根目录。首次启动时 data-init 会创建并修正子目录权限。
FOOTPRINT_DATA_DIR=./data

# 前端发布绑定的宿主机地址：默认 0.0.0.0（局域网可访问）。
# 若仅本机使用，强烈建议改为 127.0.0.1 以缩小暴露面。
# FOOTPRINT_BIND=127.0.0.1

# 后端主进程以宿主机非 root 用户身份运行（Linux/NAS 可按实际 UID/GID 调整，必须大于 0）
PUID=1000
PGID=1000

# 可选：后端信任的反向代理地址（uvicorn --forwarded-allow-ips），默认 *。
# 当存在外层 HTTPS 反向代理时，建议设置为该代理所在网段（如 172.18.0.0/16），
# 以便限流与审计日志拿到真实客户端 IP。
# 注意：后端端口仅绑定宿主机 127.0.0.1，请勿在端口映射中将其发布到
# 非回环地址——默认信任所有来源时，直连者可伪造 X-Forwarded-For。
# BACKEND_TRUSTED_PROXIES=172.18.0.0/16

# 高德地图 API Key（可选，用于 POI 搜索功能）
# 申请地址: https://lbs.amap.com/
AMAP_KEY=
AMAP_SECURITY_CODE=
