# JWT 密钥（必填，用于签发认证 token）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# 持久化数据根目录。首次启动时后端入口会创建并修正子目录权限。
FOOTPRINT_DATA_DIR=./data


# 后端主进程以宿主机非 root 用户身份运行
PUID=1000
PGID=1000


# 高德地图 API Key（可选，用于 POI 搜索功能）
# 申请地址: https://lbs.amap.com/
AMAP_KEY=
AMAP_SECURITY_CODE=

